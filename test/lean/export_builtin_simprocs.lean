-- Generate src/ansatz/tactic/simp/simproc.clj using Lean 4.33.1:
-- LEAN_SYSROOT=<toolchain> <toolchain>/bin/lean --run test/lean/export_builtin_simprocs.lean
-- Importing Lean runs every builtin_simproc/builtin_dsimproc initializer, including
-- *_decl forms and macro expansions. Simproc.lean isBuiltinSimproc uses this registry.
import Lean
open Lean Meta Simp

def main : IO Unit := do
  unless Lean.versionString == "4.33.1" do
    throw (IO.userError s!"Expected Lean 4.33.1, got {Lean.versionString}")
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Lean }] {}
  -- Read exactly the map consulted by Simp.isBuiltinSimproc, not only active
  -- simp/seval procedures: declarations without an attribute also count.
  let registry := (simprocDeclExt.getState env).builtin
  unless registry.size == (← builtinSimprocDeclsRef.get).keys.size do
    throw (IO.userError "incomplete builtin simproc environment")
  let names := (registry.toList.map Prod.fst).toArray
  let names := names.qsort (fun a b => a.toString < b.toString)
  let mut modules : Array String := #[]
  for n in names do
    let some idx := env.getModuleIdxFor? n
      | throw (IO.userError s!"No source module for builtin simproc {n}")
    let mod := env.header.moduleNames[idx]!.toString
    unless modules.contains mod do modules := modules.push mod
  modules := modules.qsort (· < ·)
  IO.println ";; Generated by test/lean/export_builtin_simprocs.lean; do not edit the inventory."
  IO.println ";; Lean 4.33.1 (819816b2e0a3bf405af45ae5c7af2491d8f5bee6):"
  IO.println ";; Meta/Tactic/Simp/Simproc.lean builtinSimprocDeclsRef / isBuiltinSimproc."
  IO.println s!";; All {names.size} registrations from {modules.size} modules, including macro-generated and private names."
  IO.println "(ns ansatz.tactic.simp.simproc)"
  IO.println "\n(def builtin-simproc-names-by-module"
  IO.println "  {"
  for mod in modules do
    IO.println s!"   {(Json.str mod).compress}"
    IO.println "   #{"
    for n in names do
      let idx := (env.getModuleIdxFor? n).get!
      if env.header.moduleNames[idx]!.toString == mod then
        IO.println s!"     {(Json.str n.toString).compress}"
    IO.println "     }"
  IO.println "   })"
  IO.println "\n(def builtin-simproc-names\n  (into #{} (mapcat val) builtin-simproc-names-by-module))"
  IO.println "\n(defn is-builtin-simproc [n]\n  (contains? builtin-simproc-names (str n)))"
