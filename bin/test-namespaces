#!/usr/bin/env python3
"""Discover tests by default; only external-fixture namespaces are excluded.

--inventory classifies every namespace, including the exact optional fixture.
Committed test-data files (arena, kernel-reference, Nat.add_succ) are CI inputs.
Mixed namespaces retain their own per-test fixture guards.
"""
import argparse
from collections import Counter
import json
from pathlib import Path
import re
import subprocess

GROUPS = 4
# These exports/stores are uncommitted and unavailable on a fresh checkout.
EXCLUDED = {
    "ansatz.foldl-assoc-generic-test": "test-data/init.ndjson",
    "ansatz.generalizing-test": "test-data/init.ndjson",
    "ansatz.induction-motive-test": "test-data/init-store or test-data/init.ndjson",
    "ansatz.int-arith-test": "Mathlib store (ANSATZ_STORE_DIR)",
    "ansatz.prelude.list-test": "test-data/init.ndjson",
    "ansatz.rw-envlemma-test": "test-data/init.ndjson",
    "ansatz.split-test": "test-data/init.ndjson",
    "ansatz.tactic.carriers-test": "Mathlib store (ANSATZ_STORE_DIR)",
    "ansatz.theory.convergence-test": "Mathlib store (ANSATZ_STORE_DIR)",
    "ansatz.theory.inferred-real-test": "Mathlib store (ANSATZ_STORE_DIR)",
}


# These are committed, so they are inputs rather than exclusions. The reducer
# namespace retains a printed skip for its optional small export.
REPOSITORY_FIXTURES = {
    "ansatz.examples-test": "checked bundled Init; optional Mathlib store",
    "ansatz.import-test": "bundled Init materialized as temporary NDJSON + bundled attributes",
    "ansatz.tactic.advanced-test": "checked bundled Init; optional Mathlib store",
    "ansatz.constructions-test": "test-data/kernel-reference/constructions.ndjson.gz",
    "ansatz.export.parser-test": "test-data/Nat.add_succ.ndjson",
    "ansatz.export.replay-test": "test-data/Nat.add_succ.ndjson",
    "ansatz.export.storage-test": "test-data/Nat.add_succ.ndjson",
    "ansatz.kernel.level-reference-test": "test-data/kernel-reference/levels.edn",
    "ansatz.kernel.reducer-test": "bundled resources; optional test-data/init-small.ndjson",
    "ansatz.kernel.typechecker-test": "test-data/Nat.add_succ.ndjson + checked bundled Init",
    "ansatz.kernel-soundness-test": "test-data/arena/{proj-of-subst-prop,rec-of-subst-prop}.ndjson",
    "ansatz.load-export-test": "test-data/Nat.add_succ.ndjson, test-data/arena/002_badDef.ndjson",
    "ansatz.store.fetch-test": "test-data/Nat.add_succ.ndjson (temporary stores, no Mathlib)",
    "ansatz.tools.arena-check-test": "test-data/arena/*.ndjson",
}


def reader_command(*args, self_test=False):
    command = ["clojure", "-J-Xmx256m", "-J-Xss8m"]
    if self_test:
        command += ["-Sdeps", '{:aliases {:discovery-script {:main-opts [] :extra-paths ["bin/fixtures/namespace-discovery"]}}}',
                    "-M:ci:discovery-script"]
    else:
        command += ["-M"]
    return command + ["bin/read-test-namespaces.clj", *args]


def namespaces():
    result = subprocess.run(reader_command("test"), stdout=subprocess.PIPE, text=True)
    if result.returncode:
        raise SystemExit(result.returncode)
    entries = json.loads(result.stdout)
    seen = {}
    for entry in entries:
        name, file = entry["namespace"], entry["file"]
        if name in seen:
            raise SystemExit(f"Duplicate namespace {name}: {seen[name]}, {file}")
        seen[name] = file
        yield name


def verify_partition(eligible, groups):
    if len(groups) != GROUPS or len(set(eligible)) != len(eligible):
        raise ValueError("Invalid namespace partition or duplicate eligible namespaces")
    actual = Counter(name for group in groups for name in group)
    if actual != Counter(eligible):
        raise ValueError(f"Namespace partition must cover every eligible namespace exactly once: {actual}")


def partition(names, excluded=EXCLUDED):
    if len(set(names)) != len(names):
        raise ValueError("Duplicate discovered namespace names")
    stale = set(excluded) - set(names)
    if stale:
        raise ValueError(f"Stale fixture exclusions: {sorted(stale)}")
    eligible = [n for n in names if n not in excluded]
    groups = [eligible[i::GROUPS] for i in range(GROUPS)]
    verify_partition(eligible, groups)
    return eligible, groups


def check_run(expected, output):
    if not expected or len(set(expected)) != len(expected):
        raise ValueError("Expected namespace list must be nonempty and unique")
    actual = Counter(re.findall(r"^Testing (\S+)[ \t]*$", output, re.MULTILINE))
    wanted = Counter(expected)
    if actual != wanted:
        missing = sorted(set(wanted) - set(actual))
        extra = sorted(set(actual) - set(wanted))
        repeated = {n: count for n, count in actual.items() if count != 1}
        raise ValueError(f"Runner namespace coverage mismatch: missing={missing}, unexpected={extra}, counts={repeated}")


def self_test():
    import tempfile
    import unittest

    class CoverageContracts(unittest.TestCase):
        def test_cli_errors_include_the_file(self):
            with tempfile.TemporaryDirectory(prefix="ansatz-discovery-cli-") as root:
                file = Path(root) / "wrong_test.clj"
                file.write_text("(ns sample.actual-test)")
                result = subprocess.run(reader_command(root), capture_output=True, text=True)
                self.assertNotEqual(0, result.returncode)
                self.assertIn(str(file), result.stderr)
                self.assertIn("requires path", result.stderr)

        def test_partition_covers_eligible_once(self):
            eligible, groups = partition(["a", "external", "b", "c", "d", "e"], {"external": "fixture"})
            self.assertEqual(["a", "b", "c", "d", "e"], eligible)
            self.assertEqual(4, len(groups))
            for bad in [[['a'], ['b'], ['c'], []], [['a'], ['b'], ['c'], ['a']]]:
                with self.assertRaises(ValueError):
                    verify_partition(["a", "b", "c", "d"], bad)

        def test_run_requires_every_namespace_once(self):
            check_run(["a", "b"], "Testing b\n\nTesting a\n")
            for output in ["Testing a\n", "Testing a\nTesting b\nTesting b\n",
                           "Testing a\nTesting b\nTesting c\n", ""]:
                with self.assertRaises(ValueError):
                    check_run(["a", "b"], output)

        def test_requested_names_are_unique_and_nonempty(self):
            for names in [[], ["a", "a"]]:
                with self.assertRaises(ValueError):
                    check_run(names, "Testing a\n")

    outcome = unittest.TextTestRunner().run(unittest.defaultTestLoader.loadTestsFromTestCase(CoverageContracts))
    if not outcome.wasSuccessful():
        raise SystemExit(1)
    result = subprocess.run(reader_command("--self-test", self_test=True))
    if result.returncode:
        raise SystemExit(result.returncode)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("group", nargs="?", type=int, choices=range(GROUPS))
    parser.add_argument("--inventory", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--check-run", type=Path)
    parser.add_argument("--expected", type=Path)
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return
    if args.check_run or args.expected:
        if not (args.check_run and args.expected):
            parser.error("--check-run and --expected must be provided together")
        try:
            check_run(args.expected.read_text().splitlines(), args.check_run.read_text())
        except ValueError as error:
            raise SystemExit(f"{args.check_run}: {error}") from error
        print(f"Verified every requested namespace ran exactly once: {args.check_run}")
        return
    names = list(namespaces())
    try:
        eligible, groups = partition(names)
    except ValueError as error:
        raise SystemExit(str(error)) from error
    for n in names if args.inventory else (eligible if args.group is None else groups[args.group]):
        if args.inventory:
            print(n, EXCLUDED.get(n, REPOSITORY_FIXTURES.get(n, "repository + bundled resources")), sep="\t")
        else:
            print(n)


if __name__ == "__main__":
    main()
