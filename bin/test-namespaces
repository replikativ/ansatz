#!/usr/bin/env python3
"""Discover tests by default; only external-fixture namespaces are excluded.

--inventory classifies every namespace, including the exact optional fixture.
Committed test-data files (arena, kernel-reference, Nat.add_succ) are CI inputs.
Mixed namespaces retain their own per-test fixture guards.
"""
import argparse
from pathlib import Path
import re

GROUPS = 4
# These exports/stores are uncommitted and unavailable on a fresh checkout.
EXCLUDED = {
    "ansatz.foldl-assoc-generic-test": "test-data/init.ndjson",
    "ansatz.generalizing-test": "test-data/init.ndjson",
    "ansatz.induction-motive-test": "test-data/init-store or test-data/init.ndjson",
    "ansatz.int-arith-test": "Mathlib store (ANSATZ_STORE_DIR)",
    "ansatz.prelude.list-test": "test-data/init.ndjson",
    "ansatz.rw-envlemma-test": "test-data/init.ndjson",
    "ansatz.split-test": "test-data/init.ndjson",
    "ansatz.tactic.carriers-test": "Mathlib store (ANSATZ_STORE_DIR)",
    "ansatz.theory.convergence-test": "Mathlib store (ANSATZ_STORE_DIR)",
    "ansatz.theory.inferred-real-test": "Mathlib store (ANSATZ_STORE_DIR)",
}


# These are committed, so they are inputs rather than exclusions. The reducer
# namespace retains a printed skip for its optional small export.
REPOSITORY_FIXTURES = {
    "ansatz.examples-test": "checked bundled Init; optional Mathlib store",
    "ansatz.import-test": "bundled Init materialized as temporary NDJSON + bundled attributes",
    "ansatz.tactic.advanced-test": "checked bundled Init; optional Mathlib store",
    "ansatz.constructions-test": "test-data/kernel-reference/constructions.ndjson.gz",
    "ansatz.export.parser-test": "test-data/Nat.add_succ.ndjson",
    "ansatz.export.replay-test": "test-data/Nat.add_succ.ndjson",
    "ansatz.export.storage-test": "test-data/Nat.add_succ.ndjson",
    "ansatz.kernel.level-reference-test": "test-data/kernel-reference/levels.edn",
    "ansatz.kernel.reducer-test": "bundled resources; optional test-data/init-small.ndjson",
    "ansatz.kernel.typechecker-test": "test-data/Nat.add_succ.ndjson + checked bundled Init",
    "ansatz.kernel-soundness-test": "test-data/arena/{proj-of-subst-prop,rec-of-subst-prop}.ndjson",
    "ansatz.load-export-test": "test-data/Nat.add_succ.ndjson, test-data/arena/002_badDef.ndjson",
    "ansatz.store.fetch-test": "test-data/Nat.add_succ.ndjson (temporary stores, no Mathlib)",
    "ansatz.tools.arena-check-test": "test-data/arena/*.ndjson",
}


def namespaces():
    for path in sorted(Path("test").rglob("*_test.clj")):
        match = re.search(r"\(ns\s+([^\s()]+)", path.read_text())
        if not match:
            raise SystemExit(f"No namespace declaration: {path}")
        yield match[1]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("group", nargs="?", type=int, choices=range(GROUPS))
    parser.add_argument("--inventory", action="store_true")
    args = parser.parse_args()
    names = list(namespaces())
    stale = set(EXCLUDED) - set(names)
    if stale:
        raise SystemExit(f"Stale fixture exclusions: {sorted(stale)}")
    eligible = [n for n in names if n not in EXCLUDED]
    for n in names if args.inventory else eligible:
        if args.inventory:
            print(n, EXCLUDED.get(n, REPOSITORY_FIXTURES.get(n, "repository + bundled resources")), sep="\t")
        elif args.group is None or eligible.index(n) % GROUPS == args.group:
            print(n)


if __name__ == "__main__":
    main()
