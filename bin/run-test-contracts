#!/bin/bash
set -eo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
engine_tests="$repo_root/modules/lean-jvm/test-engine"
mkdir -p "$repo_root/target"
contract_root=$(mktemp -d "$repo_root/target/engine-contracts.XXXXXX")
cleanup_contracts() { rm -r -- "$contract_root"; }
trap cleanup_contracts EXIT

mkdir -p "$contract_root/classes" "$contract_root/engine-classes" "$contract_root/fixtures"
javac -J-Xmx256m --release 11 -g -d "$contract_root/engine-classes" \
  "$repo_root/modules/lean-jvm/src-java/ansatz/lean/jvm/internal/exec/Interpreter.java" \
  "$repo_root/modules/lean-jvm/src-java/ansatz/lean/jvm/internal/exec/ScalarBits.java" \
  "$repo_root/modules/lean-jvm/src-java/ansatz/lean/jvm/internal/exec/Utf8Bytes.java"
javac -J-Xmx256m --release 11 -d "$contract_root/classes" \
  "$engine_tests/kernel-support/java/prototype/TypedLongMemo.java"
jar cf "$contract_root/engine.jar" -C "$contract_root/engine-classes" .
python3 "$engine_tests/prepare-fixtures.py" "$contract_root/fixtures"
(
  cd "$contract_root/fixtures"
  clojure -J-Xmx384m -J-Xss8m \
    -Sdeps "{:paths [\"$engine_tests/support\" \"$engine_tests/kernel-support\" \"$engine_tests/kernel-contracts\" \"$engine_tests/source-contracts\" \"$contract_root/classes\"] :deps {org.replikativ/ansatz {:local/root \"$repo_root\"}}}" \
    -M "$engine_tests/check-runner.clj" "$contract_root/engine.jar"
)

python3 "$engine_tests/test-code-catalogue.py"
