{:paths ["src" "classes" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        ;; 0.5.x carries `org.replikativ.persistent-sorted-set.cbor` — the canonical PSS node
        ;; handlers ansatz.export.codec installs on its boring registry. Reads of existing
        ;; Fressian stores are unchanged (the legacy node handlers still apply).
        org.replikativ/persistent-sorted-set {:mvn/version "0.5.144"}
        org.replikativ/boring {:mvn/version "0.1.27"}
        ;; 0.9.398 carries the boring (CBOR) serializer (id 3, see ansatz.export.codec) and the
        ;; nested-`go` hoists in konserve.tiered and konserve.impl.defaults — a `go` nested in
        ;; another `go` body costs ~6x at compile time, and those two namespaces were most of
        ;; konserve's load. It is also what datahike pins, so the :datahike alias overrides nothing.
        org.replikativ/konserve {:mvn/version "0.9.398"
                                 :exclusions [org.clojure/clojurescript
                                              com.github.pkpkpk/cljs-node-io
                                              com.github.pkpkpk/fress
                                              org.clojars.mmb90/cljs-cache]}
        org.replikativ/hasch {:mvn/version "0.4.104"
                              :exclusions [org.clojure/clojurescript
                                           com.cognitect/transit-cljs]}
        org.clojure/core.cache {:mvn/version "1.1.234"}}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact {:git/sha "4a9a74f0e50e897c45df8cc70684360eb30fce80"}
                 babashka/babashka.curl {:mvn/version "0.1.2"}
                 babashka/fs {:mvn/version "0.3.17"}
                 cheshire/cheshire {:mvn/version "5.11.0"}}
          :ns-default build}

  ;; The suite against the PUBLISHED JAR, with `src` off the classpath, so every namespace
  ;; comes from the AOT classes the jar actually ships. `clj -M:test` exercises the SOURCE and
  ;; would not catch an AOT-only fault — and those exist: a namespace compiled against a
  ;; dependency's protocol fails at runtime with NoClassDefFoundError, because an AOT'd class
  ;; loaded by the application classloader cannot see a protocol interface that a source-loaded
  ;; namespace generates dynamically (konserve hit exactly this). Build the jar first:
  ;;   clj -T:build jar && clj -M:jar-test -e :wip
  :jar-test {:replace-paths ["test"]
             :replace-deps {org.replikativ/ansatz {:local/root "target/ansatz.jar"}
                            io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                            metosin/malli {:mvn/version "0.16.4"}}
             :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
             :main-opts ["-m" "cognitect.test-runner" "-d" "test"]}

  ;; datahike-backed indices (optional module; own src path so the core build never sees it).
  ;; Core now pins the same konserve/persistent-sorted-set datahike does, so nothing is
  ;; overridden. Point at the released datahike once its version is known.
  :datahike {:extra-paths ["src-datahike" "test-datahike"]
             :extra-deps {org.replikativ/datahike {:local/root "../datahike"}}}

  ;; Tests
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd"}
                      ;; malli is an OPTIONAL ansatz dependency (the gradual-typing surface,
                      ;; ansatz.malli, loads lazily when malli is on the consumer's classpath);
                      ;; it is a test dep here so our own suite exercises the integration.
                      metosin/malli {:mvn/version "0.16.4"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; CI alias (same as test, for workflow clarity)
  :ci {:extra-paths ["test"]
       :extra-deps {io.github.cognitect-labs/test-runner
                    {:git/tag "v0.5.1"
                     :git/sha "dfb30dd"}}
       :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
       :main-opts ["-m" "cognitect.test-runner"]}

  ;; Code formatting check
  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check" "src" "test"]}

  ;; Code formatting fix
  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :main-opts ["-m" "cljfmt.main" "fix" "src" "test"]}

  ;; Linting
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}

  ;; Check for outdated deps
  :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.10.1241"}}
             :main-opts ["-m" "antq.core"]}

  ;; Lean Kernel Arena entry (https://arena.lean-lang.org/): one export in, exit code out.
  ;; `clojure -M:arena <export.ndjson>` or `IN=<export.ndjson> clojure -M:arena`.
  ;; Heap is left to the caller (`clojure -J-Xmx8g -M:arena …`); the checker
  ;; runs its own 64MB-stack thread, so no -Xss is needed.
  :arena {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-XX:+UseParallelGC"]
          :main-opts ["-m" "ansatz.tools.arena-check"]}

  ;; REPL
  :repl {:extra-paths ["test"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                      cider/cider-nrepl {:mvn/version "0.50.2"}
                      metosin/malli {:mvn/version "0.16.4"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "nrepl.cmdline"
                     "--middleware" "[cider.nrepl/cider-middleware]"]}}}
